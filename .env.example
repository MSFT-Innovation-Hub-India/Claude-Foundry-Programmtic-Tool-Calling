PATIENT_NAME=Srikantan
ESCALATION_EMAIL=someone@example.com
EMAIL_MODE=send
# raw = full Jira API payload goes through the model/sandbox; compact = trimmed inside the tool
JIRA_PAYLOAD=raw
# Prompt caching is on by default so a single run shows the saving against the same tokens priced without caching.
# COLD_CACHE_PER_RUN=on adds a unique line to the system prompt so every run starts with a cold cache.
PROMPT_CACHING=on
COLD_CACHE_PER_RUN=off
# Price model for the 'cost index' (relative to 1 uncached input token) - assumptions, adjust to your pricing
CACHE_READ_MULTIPLIER=0.1
CACHE_WRITE_MULTIPLIER=1.25
OUTPUT_PRICE_MULTIPLIER=5

FOUNDRY_RESOURCE=<your-foundry-resource-name>
CLAUDE_DEPLOYMENT=claude-haiku-5-5
CODE_EXECUTION_TOOL_VERSION=code_execution_20260120

ATLASSIAN_API_KEY=<atlassian-api-token>
ATLASSIAN_USER_NAME=<atlassian-account-email>
ATLASSIAN_URL=https://<your-site>.atlassian.net/
GRIEVANCE_PROJECT_KEY=DEMO
GRIEVANCE_TYPE=Task
GRIEVANCE_PROJECT_NAME=Demo service space

AZ_DB_SERVER=<server>.database.windows.net
AZ_DB_DATABASE=<database>
AZ_DB_DRIVER=ODBC Driver 18 for SQL Server
